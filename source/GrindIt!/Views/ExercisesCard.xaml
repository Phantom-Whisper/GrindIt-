<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GrindIt_.Views.ExercisesCard">
    <Border
        Stroke="Transparent">
        <Grid
            Margin="20,5,10,10"
            ColumnDefinitions="20*,80*">
            <Border
                WidthRequest="34"
                HeightRequest="34"
                StrokeShape="50"
                StrokeThickness="0"
                BackgroundColor="{StaticResource Primary}"
                HorizontalOptions="Start">
                <Label
                    Text="{Binding Initial}"
                    FontFamily="AwesomeSolid"
                    FontSize="20"
                    TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
            <Label
                Grid.Column="1"
                Text="{Binding Name}"
                FontSize="Medium"
                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                VerticalOptions="Center"/>
        </Grid>
    </Border>
</ContentView>