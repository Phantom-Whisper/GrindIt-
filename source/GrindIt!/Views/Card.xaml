<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GrindIt_.Views"
             x:DataType="local:Card"
             x:Class="GrindIt_.Views.Card">
    <Grid
        Margin="10,5">
        <!--Main container-->
        <Border
            Stroke="Transparent"
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CodGray}}"
            StrokeShape="15"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
            <Border.Shadow>
                <Shadow
                    Brush="#000000"
                    Offset="4,4"
                    Radius="8"
                    Opacity=".25"/>
            </Border.Shadow>
            <Grid
                Padding="10"
                ColumnDefinitions="60*, 40*"
                ColumnSpacing="10"
                RowDefinitions="*, *"
                RowSpacing="10">
                <Grid
                    ColumnDefinitions="auto,*"
                    ColumnSpacing="5">
                    <!--Glyph Icon-->
                    <Border
                    HorizontalOptions="Start"
                    WidthRequest="35" 
                    HeightRequest="35"
                    Stroke="Transparent"
                    StrokeShape="50">
                        <Label 
                        Text="{Binding Glyph}" 
                        FontFamily="AwesomeSolid"
                        FontSize="20" 
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <!--Text-->
                <Label
                    Grid.Column="1"
                    Text="{Binding Text}" 
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    FontSize="{OnIdiom Phone=Medium, Tablet=Large}"
                    VerticalOptions="Center"/>
                </Grid>
                <!--Button-->
                <Button 
                    Grid.Row="1"
                    Text="{Binding Value}"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    BackgroundColor="{DynamicResource Primary}"
                    FontAttributes="Bold" HorizontalOptions="Start"
                    CornerRadius="50" 
                    HeightRequest="40" 
                    WidthRequest="125"/>
                <!-- Chart -->
                <Border 
                    Grid.Column="1"
                    Grid.RowSpan="2"
                    Stroke="Transparent"
                    MinimumHeightRequest="100" 
                    MaximumHeightRequest="150"
                    MinimumWidthRequest="100"
                    MaximumWidthRequest="150"/>
            </Grid>
        </Border>
    </Grid>
</ContentView>
