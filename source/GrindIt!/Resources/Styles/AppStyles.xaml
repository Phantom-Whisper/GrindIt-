<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    
    <Style TargetType="Border" x:Key="HomeBorder">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CodGray}}"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeShape" Value="15"/>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow
                    Brush="{StaticResource Black}"
                    Offset="4,4"
                    Radius="4"
                    Opacity=".25"/>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="toolkit:Expander" x:Key="ExpanderStyle">
        <Setter Property="Margin" Value="10,0,0,15" />
    </Style>

    <Style TargetType="Label" x:Key="ExpanderHeaderStyle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource Primary}"/>
    </Style>

    <Style TargetType="Label" x:Key="ExpanderContentStyle">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="Gray" />
    </Style>
    
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Shell.NavBarIsVisible" Value="False"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource OffBlack}}" />
    </Style>
</ResourceDictionary>