<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GrindIt_.Pages.Account_and_Settings"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ext="clr-namespace:GrindIt_.Resources.Localization"
             x:Class="GrindIt_.Pages.Account_and_Settings.FAQ"
             x:DataType="local:FAQ"
             Title="FAQ"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout
            Spacing="15">
            <!--Return Button-->
            <Button
                Text=""
                FontFamily="AwesomeSolid"
                FontSize="24"
                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                BackgroundColor="Transparent"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                HeightRequest="48"
                WidthRequest="48"
                Margin="0,10,20,0"
                Clicked="Return_Clicked"/>
            <!--Text Helper-->
            <Label
                Text="{ext:LocalizedString Key=FAQHelperText}"
                TextColor="{StaticResource Gray400}"
                Margin="10,0,0,10"/>
            <!--FAQ Section-->
            <toolkit:Expander
                Margin="10,0,0,0">
                <toolkit:Expander.Header>
                    <Label Text="What is this app about?" FontSize="18" FontAttributes="Bold" />
                </toolkit:Expander.Header>
                <Label Text="Lorem ipsum dolor sit amet consectetur adipiscing elit."
                       FontSize="16"
                       TextColor="Gray" />
            </toolkit:Expander>

            <toolkit:Expander
                Margin="10,0,0,0">
                <toolkit:Expander.Header>
                    <Label Text="How to reset my password?" FontSize="18" FontAttributes="Bold" />
                </toolkit:Expander.Header>
                <Label Text="Lorem ipsum dolor sit amet consectetur adipiscing elit."
                       FontSize="16"
                       TextColor="Gray" />
            </toolkit:Expander>

            <toolkit:Expander
                Margin="10,0,0,0">
                <toolkit:Expander.Header>
                    <Label Text="Is dark mode supported?" FontSize="18" FontAttributes="Bold" />
                </toolkit:Expander.Header>
                <Label Text="Lorem ipsum dolor sit amet consectetur adipiscing elit."
                       FontSize="16"
                       TextColor="Gray" />
            </toolkit:Expander>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
