<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ext="clr-namespace:GrindIt_.Resources.Localization"
             xmlns:local="clr-namespace:GrindIt_.Pages.Account_and_Settings"
             xmlns:models="clr-namespace:GrindIt_.Models"
             x:Class="GrindIt_.Pages.Account_and_Settings.PreferencesPage"
             x:DataType="local:PreferencesPage"
             Title="PreferencesPage"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout>
            <!--Return Button-->
            <Button
                Text=""
                FontFamily="AwesomeSolid"
                FontSize="24"
                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                BackgroundColor="Transparent"
                HorizontalOptions="Start"
                VerticalOptions="Start" 
                Margin="0,10,20,0"
                HeightRequest="48"
                WidthRequest="48"
                Clicked="Return_Clicked"/>
            <!--Culture Picker Label-->
            <Label
                Text="{ext:LocalizedString Key=CulturePickerTitle}"
                HorizontalOptions="Center"
                FontSize="Medium"/>
            <!--Culture Picker-->
            <Picker 
                x:Name="CulturePicker"
                HorizontalOptions="Center"
                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                SelectedIndexChanged="CulturePicker_SelectedIndexChanged"
                ItemDisplayBinding="{Binding Name}" x:DataType="models:CultureItem" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>