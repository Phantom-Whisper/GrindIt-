<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GrindIt_.Pages.Account_and_Settings"
             x:Class="GrindIt_.Pages.Account_and_Settings.Account"
             x:DataType="local:Account"
             Title="AccountView"
             Shell.NavBarIsVisible="False">
    <VerticalStackLayout>
        <!--Menu Button-->
        <Button
            Text="&#xf013;"
            FontFamily="AwesomeSolid"
            FontSize="30"
            TextColor="{AppThemeBinding Light=Black, Dark=White}"
            BackgroundColor="Transparent"
            HorizontalOptions="End"
            VerticalOptions="Start" 
            Margin="0,10,0,0"
            HeightRequest="60"
            WidthRequest="60"
            Clicked="Menu_Clicked"/>
        <Border
            HeightRequest="100"
            WidthRequest="100"
            HorizontalOptions="Start"
            Margin="20,0,0,10">
            <Border.StrokeShape>
                <Ellipse />
            </Border.StrokeShape>
            <Image
                Source="gym_background.jpg"
                Aspect="AspectFill" />
        </Border>

        <Label 
            Text="Name"
            HorizontalOptions="Start"
            Margin="20,0,10,0" />
    </VerticalStackLayout>
</ContentPage>