<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ext="clr-namespace:GrindIt_.Resources.Localization"
             x:Class="GrindIt_.Pages.Account_and_Settings.Theme"
             Title="ThemeView"
             Shell.NavBarIsVisible="False">
    <VerticalStackLayout>
        <!--Return Button-->
        <Button
            Text=""
            FontFamily="AwesomeSolid"
            FontSize="24"
            TextColor="{AppThemeBinding Light=Black, Dark=White}"
            BackgroundColor="Transparent"
            HorizontalOptions="Start"
            VerticalOptions="Start" 
            Margin="10,10,20,0"
            HeightRequest="48"
            WidthRequest="48"
            Clicked="Return_Clicked"/>
        <Label
            Text="{ext:LocalizedString Key=ThemePreferences}"
            Style="{StaticResource SubHeadline}"/>
        <Grid
            ColumnDefinitions="*,*"
            Margin="20,10,20,0">
            <Label
                Text="{ext:LocalizedString Key=DarkMode}"
                VerticalOptions="Center"
                HorizontalOptions="End"/>
            <Switch
                Grid.Column="1"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Toggled="Switch_Toggled"/>
        </Grid>
        <Label
            Text="{ext:LocalizedString Key=ThemeMainColour}"
            HorizontalOptions="Center"/>
        <Label
            Text="{ext:LocalizedString Key=ThemeRestoreDefault}"
            HorizontalOptions="Center"/>
        <!--Add grid with all the colors you can use for the app theme-->
    </VerticalStackLayout>
</ContentPage>