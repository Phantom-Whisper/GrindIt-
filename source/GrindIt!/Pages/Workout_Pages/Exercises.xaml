<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GrindIt_.Pages.Workout_Pages"
             x:Class="GrindIt_.Pages.Workout_Pages.Exercises"
             x:DataType="local:Exercises"
             Title="Exercises">
    <VerticalStackLayout>
        <Grid
            ColumnDefinitions="*,*">
            <!--Return Button-->
            <Button
                Text=""
                FontFamily="AwesomeSolid"
                FontSize="24"
                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                BackgroundColor="Transparent"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                HeightRequest="48"
                WidthRequest="48"
                Clicked="Return_Clicked"/>
            <!--Create Exercise Button-->
            <Button
                Grid.Column="1"
                Text="Create Exercise"
                Margin="0,10,20,20"
                HeightRequest="40"
                CornerRadius="30"
                HorizontalOptions="End"
                Clicked="CreateExercise_Clicked"/>
        </Grid>


        <SearchBar
            Placeholder="Name of the exercise"
            Margin="10,0,30,10"/>

        <!--List of all the targeted muscle and their exercise-->
        <Button
            Text="Exercise"
            Clicked="Exercise_Clicked"/>
    </VerticalStackLayout>
</ContentPage>