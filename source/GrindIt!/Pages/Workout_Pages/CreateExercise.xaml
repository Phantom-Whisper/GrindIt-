<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GrindIt_.Pages.Workout_Pages"
             x:Class="GrindIt_.Pages.Workout_Pages.CreateExercise"
             x:DataType="local:CreateExercise"
             Title="Create Exercise"
             Shell.NavBarIsVisible="False">
    <VerticalStackLayout Spacing="10">
        <Grid
            ColumnDefinitions="*,*">
            <!--Return Button-->
            <Button
                Text=""
                FontFamily="AwesomeSolid"
                FontSize="24"
                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                BackgroundColor="Transparent"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                HeightRequest="48"
                WidthRequest="48"
                Clicked="Return_Clicked"/>
            <Button
                Grid.Column="1"
                Text="Create"
                HorizontalOptions="End"
                Margin="0,10,20,0"
                HeightRequest="40"
                WidthRequest="100"
                CornerRadius="50"/>
        </Grid>
        
        <Label 
            Text="Name the exercise"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Entry
            Margin="40,20,40,0"
            Placeholder="Name of the exercise"/>

        <Grid
            HorizontalOptions="Center"
            ColumnDefinitions="50*,50*"
            ColumnSpacing="20">
            <Label
                Text="Bodyweight exercise "
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Grid.Column="0"/>

            <CheckBox
                HorizontalOptions="Start"
                Grid.Column="1"/>
        </Grid>
        <!--Lists of muscle groups-->
        <Label
            Text="Select at least one muscle targeted"
            HorizontalOptions="Center"
            VerticalOptions="Center"/>
        <Button
            Text="+"
            Padding="8"
            FontFamily="AwesomeSolid"
            CornerRadius="50"
            FontSize="16"
            WidthRequest="28"/>
        <!--eventHandler-->
        <!--When toggled show a list of the muscles-->
    </VerticalStackLayout>
</ContentPage>